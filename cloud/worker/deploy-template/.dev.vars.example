# Cloudflare API token from the template link in README.md (create it first). You can also paste it on the setup page.
CF_API_TOKEN=
# Setup code: at least 24 random characters, e.g. `openssl rand -base64 24`. You type it once, on the setup page.
SETUP_CODE=
# Data key: at least 32 random bytes, e.g. `openssl rand -base64 32`. Encrypts the secrets the Worker stores; keep a copy.
DATA_KEY=
