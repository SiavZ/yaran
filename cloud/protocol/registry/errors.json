{
  "description": "Design §4 error codes. Never reused; reserved codes are never emitted; local codes are used by openers and decoders only (no HTTP). status null = no HTTP status of its own (callback-only or local).",
  "codes": [
    {
      "code": "bad_request",
      "status": 400,
      "retryable": false,
      "emitted_by": [
        "any"
      ],
      "summary": "Malformed request."
    },
    {
      "code": "validation_failed",
      "status": 400,
      "retryable": false,
      "emitted_by": [
        "any"
      ],
      "summary": "Schema validation failed; details.errors lists up to 20 {path, message}."
    },
    {
      "code": "protocol_unsupported",
      "status": 400,
      "retryable": false,
      "emitted_by": [
        "any"
      ],
      "summary": "No protocol version both sides support; details {min, max}."
    },
    {
      "code": "unauthenticated",
      "status": 401,
      "retryable": false,
      "emitted_by": [
        "worker"
      ],
