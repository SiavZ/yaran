/target
# Side build directories (CARGO_TARGET_DIR pointed at e.g. target-pr, used to
# review a branch without disturbing the main build cache).
/target-*/
/dist

# Node caches. The web app's real node_modules lives under crates/yaran-web/web
# (covered by its own .gitignore); this guards against a stray one appearing at
# the root, e.g. an npx/vitest invocation run from the wrong directory.
node_modules/

# Web UI build output, regenerated by the yaran-web front-end build.
crates/yaran-web/web/dist/

# Scratch copies of that build output. Proving the build correctly FAILS when the
# web assets are missing means moving them aside and putting them back, so a
# half-finished run of that check can leave one of these behind. Ignored so a
# stray one never looks like a change worth committing.
dist.real/
dist.bak/
dist.orig/
flamegraph.svg
perf.data
perf.data.old

# Debug output: logs, crash dumps, and coverage/profiling data from local runs.
*.log
# Recorded measurement logs are kept on purpose, next to their write-ups.
!tools/preview-env/measurements/*.log
*.profraw
*.profdata
yaran-crash.log
core
core.*
# The phone app's native core library is a directory, not a crash dump.
!mobile/plugins/core/
.DS_Store

# Local-only branch catch-up notes (not for version control)
docs/server-mode-summary.md

# Subagent-driven-development scratch (briefs, reports, review packages)
.superpowers/

# Inter-agent mailbox scratch, not part of the project
.agent-mail/

# Local agent (Claude Code) settings and state. Machine-local by design: the
# upstream repo tracked .claude/settings.local.json once, removed it in 6c70a23b,
# and a later commit re-added it by accident; ignoring the directory keeps any
# local agent configuration from ever being committed again.
.claude/
