<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NSE entitlements (Phase 16): the app group name doubles as the keychain access group
     (kSecAttrAccessGroup = the group id, no team prefix), so the extension reads the per-org
     push keys the app wrote. The time-sensitive key
     com.apple.developer.usernotifications.time-sensitive is added once Phase 21 confirms it
     (UNVERIFIED); provisioning profiles are Phase 18's. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(YARAN_APP_GROUP)</string>
	</array>
</dict>
</plist>
