<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system trust anchors, no certificate pins (R5 §5.6): orgs run on
     user-chosen domains, so a pin would have nothing stable to pin to. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
