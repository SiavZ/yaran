<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The shell is dark-only like the web UI; colours come from the shared tokens
         (yaran_colors.xml, generated by packages/ui-kit/scripts/export-native-colors.mjs). -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/yaran_primary</item>
        <item name="colorPrimaryDark">@color/yaran_background</item>
        <item name="colorAccent">@color/yaran_primary</item>
        <item name="android:windowBackground">@color/yaran_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/yaran_background</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
