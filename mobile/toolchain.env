# The one home of the mobile toolchain pins (phone-app plan, Phase 18). Node is pinned
# separately in /.node-version, the repo's only Node pin. Workflows load this file into
# $GITHUB_ENV (KEY=VALUE lines only; no quotes, no shell expansion), and
# tools/release-trains/check-versions.mjs compares the SDK and deployment-target values
# with Phase 14's Gradle and Xcode projects, so the two cannot drift.

# JDK for AGP 8.13 and Gradle (temurin); Phase 14 compiles for Java 21.
JAVA_VERSION=21
# apksigner must come from build-tools 34: the only release whose output apksigcopier
# (F-Droid reproducible builds) can verify.
ANDROID_BUILD_TOOLS=34.0.0
# Play's target API requirement (Phase 14 sets both in the app module).
ANDROID_COMPILE_SDK=36
ANDROID_TARGET_SDK=36
# D8: the .https ASWebAuthenticationSession callback needs iOS 17.4.
IOS_DEPLOYMENT_TARGET=17.4
# Apple uploads need Xcode 26 and the iOS 26 SDK. A path missing from the runner image
# fails the job loudly; it never falls back to the image default.
XCODE_APP=/Applications/Xcode_26.6.app
# Simulator for xcodebuild test (installed with Xcode 26.6 on macos-26).
IOS_SIM_DEVICE=iPhone 17
IOS_SIM_OS=26.5
# Ruby for fastlane; fastlane itself is pinned in mobile/Gemfile.lock.
RUBY_VERSION=3.4.12
# apksigcopier compares the developer-signed foss APK with F-Droid's unsigned rebuild.
APKSIGCOPIER_VERSION=1.1.1
# fdroidserver, pinned by digest.
FDROIDSERVER_IMAGE=registry.gitlab.com/fdroid/docker-executable-fdroidserver@sha256:2ad114edee50aad92fcc83fe7d801d8922780a021db070ae9f4c49f6f647c037
# SwiftLint for `swiftlint --strict` (portable_swiftlint.zip from the GitHub release).
SWIFTLINT_VERSION=0.65.1
SWIFTLINT_SHA256=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0
