      "status": 500,
      "refusal": null,
      "expect": {
        "decision": "none",
        "diagnostic": false
      }
    },
    {
      "name": "bad gateway",
      "status": 502,
      "refusal": null,
      "expect": {
        "decision": "none",
        "diagnostic": false
      }
    },
    {
      "name": "401 from access",
      "status": 401,
      "refusal": null,
      "expect": {
        "decision": "reauth",
        "diagnostic": false
      }
    },
    {
      "name": "403 from access",
      "status": 403,
      "refusal": null,
      "expect": {
