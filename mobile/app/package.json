{
  "name": "@yaran/mobile-shell",
  "version": "0.1.0",
  "private": true,
  "description": "The yaran phone app's bundled shell UI: onboarding, orgs, machines and settings (Capacitor 8).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "extract": "lingui extract --clean",
    "sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
