    "@capacitor/ios": "8.6.2",
    "@fontsource-variable/geist": "5.3.0",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@yaran/machine-view": "file:../plugins/machine-view",
    "@yaran/protocol": "file:../../cloud/protocol",
    "@yaran/qr": "file:../plugins/qr",
    "@yaran/secure-store": "file:../plugins/secure-store",
    "@yaran/ui-kit": "file:../../packages/ui-kit",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "@lingui/babel-plugin-lingui-macro": "6.12.0",
    "@lingui/cli": "6.12.0",
    "@lingui/conf": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
