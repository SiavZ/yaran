# Phase 03 gate settings. Copy to tools/cloud-gates/.env.local (gitignored), fill in, then:
#   set -a; . ./.env.local; set +a
# Never commit real values. Secrets (tokens, passwords, device tokens) are better left
# UNSET here: every script asks for a missing secret at a hidden prompt instead.
# Placeholders follow D16: <staging-zone>, <team>; no real publisher value belongs in the repo.

# --- Staging account A (Zero Trust org created after 2026-10-05, Workers Paid, one zone) ---
# Account id (32 hex) of staging account A.
GATE_CF_ACCOUNT_ID=
# Gate runner token: account-owned, the union of the G9 permissions. Secret: prefer the prompt.
GATE_CF_API_TOKEN=
# The staging zone name, e.g. <staging-zone>.
GATE_STAGING_ZONE=
# Zero Trust team name: the <team> in <team>.cloudflareaccess.com.
GATE_TEAM=
# The test identity the owner-only policies allow (One-time PIN to a maintainer mailbox is enough).
GATE_OWNER_EMAIL=
# Machine hostname for the tunnel gates (G1, G2, G3, G6, G12), e.g. gate-m1.<staging-zone>.
GATE_MACHINE_HOST=
# Control-plane hostname for the Worker gates (G8, G13 consent page, G14), e.g. gate-cp.<staging-zone>.
GATE_CP_HOST=
# Stand-in for <publisher-domain> (G13), e.g. gate-cb.<staging-zone>.
GATE_CALLBACK_HOST=

# --- Tooling (defaults shown) ---
# cloudflared binary and the version floor (VULN-170057 fix); the scripts refuse older binaries.
GATE_CLOUDFLARED=cloudflared
GATE_CLOUDFLARED_MIN=2026.11.0
# How wrangler is run; the gate token reaches it as CLOUDFLARE_API_TOKEN in its environment only.
GATE_WRANGLER="npx --yes wrangler@4.162.0"
# Echo origin port (02's default origin_port) and the cloudflared metrics port.
GATE_ORIGIN_PORT=3890
GATE_METRICS_PORT=20241
# Cloudflare API base; only changed to point at a local stub.
CF_API_BASE=https://api.cloudflare.com/client/v4

# --- Optional: yaran behind the gate tunnel (G1 step 6, G2 step 9) ---
# Web port of tools/preview-env (its default is 8790). Unset skips those steps.
GATE_YARAN_PORT=
# A live pty id inside preview-env for the PTY socket probe (asked for when unset).
GATE_YARAN_PTY_ID=

# --- Optional: automated identity (Phase 19 provides it; enables the --recheck JWT steps) ---
# A shell command printing one fresh Access JWT for $GATE_IDENTITY_HOST on its last line.
GATE_IDENTITY_JWT_CMD=

# --- G3: staging account B (org created before 2026-10-05). Unset = "not available". ---
GATE_B_CF_ACCOUNT_ID=
GATE_B_CF_API_TOKEN=
GATE_B_STAGING_ZONE=
GATE_B_TEAM=
GATE_B_MACHINE_HOST=

# --- G10: scratch account C (no Zero Trust org) and a non-member mailbox ---
GATE_C_CF_ACCOUNT_ID=
GATE_C_CF_API_TOKEN=
# An address that is NOT a member of account A, for the One-time PIN sign-in.
GATE_NONMEMBER_EMAIL=

# --- G4: Apple ---
# Path to the APNs auth key (.p8); the file itself stays outside the repo.
GATE_APNS_P8_FILE=
GATE_APNS_KEY_ID=
GATE_APPLE_TEAM_ID=
# The spike's test bundle id (apns-topic).
GATE_APNS_TOPIC=
# Device tokens shown by the spike app (secret: prefer the prompt).
GATE_APNS_SIMULATOR_TOKEN=
GATE_APNS_IPHONE_TOKEN=

# --- G5 / G7 / G13: Android ---
# Spike application id (the hijack module appends .hijack).
GATE_SPIKE_PACKAGE=io.github.siavz.yaran.gatespike
# adb serial for the Doze / force-stop steps; unset prints them as checklist steps.
GATE_ADB_SERIAL=
# Signing keystore for G7 (outside the repo), its alias, and its password (prefer the prompt).
GATE_ANDROID_KEYSTORE=
GATE_ANDROID_KEY_ALIAS=
GATE_ANDROID_KEYSTORE_PASS=
# apksigner from build-tools 34 (default: $ANDROID_HOME/build-tools/34.0.0/apksigner).
GATE_APKSIGNER=
# Where G7 copies the signed APK (default $HOME); never inside the repo.
GATE_G07_OUT_DIR=
# fdroidserver image, Node version for the clean builds, a pushed commit, the build command override.
GATE_FDROID_IMAGE=registry.gitlab.com/fdroid/fdroidserver:buildserver
GATE_NODE_VERSION=22.22.3
GATE_G07_COMMIT=
GATE_G07_BUILD_CMD=
# Local fdroiddata checkout (unset skips readmeta/lint/build/publish) and the Binaries URL (%v = version).
GATE_FDROIDDATA_DIR=
GATE_FDROID_BINARIES_URL=
# G13: the spike's debug signing certificate SHA-256 (colon hex) and <team id>.<bundle id>.
GATE_ANDROID_CERT_SHA256=
GATE_APPLE_APP_ID=

# --- G11: Deploy button branches (pushed only after a confirmation) ---
GATE_GIT_REMOTE_URL=https://github.com/SiavZ/yaran.git
GATE_DEPLOY_BRANCH=cloud-gates/deploy-probe

# --- Per-gate tokens (secret: prefer the prompts) ---
# G9: the token created from the template, and each one-permission-removed token in turn.
GATE_G09_TOKEN=
# G10: tokens without the Access organization permission (accounts A and C).
GATE_G10_TOKEN_NOACCESS=
GATE_C_TOKEN_NOACCESS=
# G14: token A (Workers Scripts Write) and token B (A + Zone Read, DNS Write, Workers Routes Write).
GATE_G14_TOKEN_A=
GATE_G14_TOKEN_B=

# --- Timings ---
# G12: how long to hold the WebSocket open past the JWT exp, in seconds.
GATE_G12_HOLD_PAST_EXP=900

# --- Set by run.sh, not by you ---
# GATES_RECHECK=1 (unattended), GATES_RECHECK_OUT=<file for the JSON summary>,
# GATES_EVIDENCE_ROOT=<override evidence root, used by the tests>.
