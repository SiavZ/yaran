#!/usr/bin/env bash
# claude-amq: launch Claude Code with AMQ co-op identity.
#
# Identity defaults to the git branch of CWD (= yaran worktree name);
# falls back to "claude-<pid>" when not in a git worktree.
# Skips AMQ wrapping for oneshot (-p / --print) invocations.
# Uses globally locked store/session ownership at $AMQ_GLOBAL_ROOT and never
# auto-creates .amqrc in the worktree.
#
# Optional session-history seeding (OFF by default — see notes below):
#   Set CLAUDE_AMQ_SEED_FROM_PARENT=1 to enable. Be aware: rsync clones the
#   parent worktree's full Claude history (~100 MB on heavy repos) — disk
#   amplification N×, possible token-billing escalation, and cross-worktree
#   info leak (parent transcripts may carry secrets/PII from a different
#   feature). Pair with `resume_args = ["--resume"]` in yaran config if used.
#   Avoid combining with `--continue`: the latest parent session may carry
#   a deferred-tool marker that --continue refuses.
set -euo pipefail

# Legacy inputs remain supported. An explicitly empty YARAN_* value wins.
for _legacy_key in ${!DUX_@}; do
  _yaran_key="YARAN_${_legacy_key#DUX_}"
  if [[ -z "${!_yaran_key+x}" ]]; then
    printf -v "$_yaran_key" '%s' "${!_legacy_key}"
    export "${_yaran_key?}"
  fi
done
unset _legacy_key _yaran_key

STATE_ROOT="${STATE_ROOT:-/data/state}"

version_at_least() {
  local actual="$1" minimum="$2"
  local a_major a_minor a_patch m_major m_minor m_patch
  IFS=. read -r a_major a_minor a_patch <<<"$actual"
  IFS=. read -r m_major m_minor m_patch <<<"$minimum"
  [[ "$a_major" =~ ^[0-9]+$ && "$a_minor" =~ ^[0-9]+$ && "$a_patch" =~ ^[0-9]+$ ]] || return 1
  (( 10#$a_major > 10#$m_major )) ||
    (( 10#$a_major == 10#$m_major && 10#$a_minor > 10#$m_minor )) ||
    (( 10#$a_major == 10#$m_major && 10#$a_minor == 10#$m_minor && 10#$a_patch >= 10#$m_patch ))
}

require_provider_version() {
  local provider="$1" minimum="$2" output actual
  if ! command -v "$provider" >/dev/null 2>&1; then
    printf '%s-amq: %s is not installed or not on PATH\n' "$provider" "$provider" >&2
    exit 1
  fi
  output=$("$provider" --version 2>&1 || true)
  actual=$(printf '%s\n' "$output" | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)
  if [[ -z "$actual" ]]; then
    printf '%s-amq: refusing %s because its version could not be parsed from %q; minimum supported is %s\n' \
      "$provider" "$provider" "$output" "$minimum" >&2
    exit 1
  fi
  if ! version_at_least "$actual" "$minimum"; then
    printf '%s-amq: refusing vulnerable %s %s; upgrade to >= %s\n' \
      "$provider" "$provider" "$actual" "$minimum" >&2
    exit 1
  fi
}

require_provider_version claude 2.1.163

# Returns 0 when $PWD is *inside* the yaran worktrees directory, 1 otherwise.
#
# Why not a simple `[[ "$PWD" == "$YARAN_HOME/worktrees/"* ]]` glob (the
# previous implementation): the glob also matches sibling directories
# whose names start with `worktrees`, e.g. `/data/state/yaran/worktrees-evil/x`.
# That path-prefix vs path-segment distinction is the audit01 P0-5 bug.
#
# We canonicalize both sides via `realpath --` so a symlinked YARAN_HOME
# or a CWD reached through a symlink still resolves correctly. The
# trailing slash on `pwd_real/` plus the `/*` pattern on the case label
# enforces a real path-segment boundary: `/foo/worktrees/` matches but
# `/foo/worktrees-evil/` does not.
#
# Linux note: `realpath --` requires GNU coreutils (the install.sh
# preflight enforces this). On macOS, `realpath` accepts the same flag
# starting with coreutils 9.x via brew; users on stock BSD realpath
# need `brew install coreutils` and either alias or set PATH so that
# `grealpath`/GNU realpath wins.
is_yaran_worktree() {
  local pwd_real worktrees_real
  pwd_real=$(realpath -- "$PWD" 2>/dev/null)        || return 1
  worktrees_real=$(realpath -- "${YARAN_HOME:-$STATE_ROOT/yaran}/worktrees" 2>/dev/null) || return 1
  case "$pwd_real/" in
    "$worktrees_real"/*) return 0 ;;
    *)                   return 1 ;;
  esac
}

for arg in "$@"; do
  case "$arg" in
    -p|--print|--bare) exec claude "$@" ;;
  esac
done

seed_session_history() {
  # OFF by default. Set CLAUDE_AMQ_SEED_FROM_PARENT=1 to enable.
  [[ "${CLAUDE_AMQ_SEED_FROM_PARENT:-}" == "1" ]] || return 0

  local git_dir git_common_dir main_worktree
  git_dir=$(git -C "$PWD" rev-parse --absolute-git-dir 2>/dev/null) || return 0
  git_common_dir=$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  [[ "$git_dir" == "$git_common_dir" ]] && return 0
  main_worktree=$(git -C "$PWD" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree / {print $2; exit}')
  [[ -z "$main_worktree" || "$main_worktree" == "$PWD" ]] && return 0

  # Encode each path with the shared encoder script (single source of
  # truth — see yaran-amq/scripts/encode-claude-project-dir). The previous
  # inline `sed` only handled `/` and `_`; in reality Claude Code rewrites
  # every char outside [A-Za-z0-9-] to `-`, so paths containing `.`,
  # spaces, or other punctuation seeded into the wrong directory and the
  # parent transcripts were silently never picked up.
  if ! command -v encode-claude-project-dir >/dev/null 2>&1; then
    printf 'claude-amq: encode-claude-project-dir not on PATH; skipping seed\n' >&2
    return 0
  fi
  # `--` guards against pathological paths that begin with `-`. We also
  # capture $PWD / $main_worktree via `printf '%s'` (P2-3) before passing
  # to the encoder — `echo` would interpret a leading `-n` / `-e` as flags.
  local enc_self enc_main self_dir main_dir pwd_str main_str
  pwd_str=$(printf '%s' "$PWD")
  main_str=$(printf '%s' "$main_worktree")
  enc_self=$(encode-claude-project-dir -- "$pwd_str") || return 0
  enc_main=$(encode-claude-project-dir -- "$main_str") || return 0
  self_dir="$HOME/.claude/projects/$enc_self"
  main_dir="$HOME/.claude/projects/$enc_main"

  [[ ! -d "$main_dir" ]] && return 0
  if compgen -G "$self_dir/*.jsonl" >/dev/null 2>&1; then
    return 0
  fi

  mkdir -p "$self_dir"
  # Audit02 P1-D: previously rsync errors were swallowed via `2>/dev/null
  # || true` and the wrapper happily reported "seeded N past sessions"
  # even when the seed was partial (or empty). Capture stderr to a
  # tempfile, count any warnings, and report partial-seed status
  # accurately. Seeding is best-effort — we don't fail the wrapper — but
  # the user must see the error count so a silent partial seed can't
  # masquerade as success.
  local rsync_log seed_rc=0
  rsync_log=$(mktemp -t claude-amq-seed.XXXXXX) || {
    echo "claude-amq: could not allocate tempfile for seed log; skipping seed" >&2
    return 0
  }
  if command -v rsync >/dev/null 2>&1; then
    if ! rsync -a "$main_dir"/ "$self_dir"/ 2>"$rsync_log"; then
      seed_rc=$?
      echo "claude-amq: seed partial (rsync rc=$seed_rc); see $rsync_log" >&2
    fi
  else
    if ! cp -r "$main_dir"/. "$self_dir"/ 2>"$rsync_log"; then
      seed_rc=$?
      echo "claude-amq: seed partial (cp rc=$seed_rc); see $rsync_log" >&2
    fi
  fi
  local n warn_lines
  n=$(find "$self_dir" -name '*.jsonl' 2>/dev/null | wc -l)
  if [[ -s "$rsync_log" ]]; then
    warn_lines=$(wc -l <"$rsync_log" | tr -d '[:space:]')
    echo "claude-amq: seeded $n files (with $warn_lines rsync warnings; see $rsync_log)" >&2
  else
    echo "claude-amq: seeded $n past sessions from $main_worktree" >&2
    rm -f "$rsync_log"
  fi
}
seed_session_history || true

if [[ -n "${YARAN_STORE_ID:-}" || -n "${YARAN_SESSION_ID:-}" || -n "${YARAN_AMQ_HANDLE:-}" ]]; then
  if [[ -z "${YARAN_STORE_ID:-}" || -z "${YARAN_SESSION_ID:-}" || -z "${YARAN_AMQ_HANDLE:-}" ]]; then
    printf 'claude-amq: YARAN_STORE_ID, YARAN_SESSION_ID, and YARAN_AMQ_HANDLE must be set together\n' >&2
    exit 1
  fi
  ME="$YARAN_AMQ_HANDLE"
  MANAGED_IDENTITY=1
else
  ME="${AM_ME:-}"
  MANAGED_IDENTITY=0
fi
# Identity priority:
#   1. AM_ME from env (explicit override)
#   2. yaran worktree dir basename — stable per-pane and unique, even if the
#      git branch was renamed or checked out to something unexpected
#   3. git branch (legacy fallback, using plumbing per CLAUDE.md git safety)
#   4. claude-<pid> (no-context fallback)
if [[ -z "$ME" ]] && is_yaran_worktree; then
  ME=$(basename "$PWD")
fi
if [[ -z "$ME" ]]; then
  ME=$(git -C "$PWD" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
fi
[[ -z "$ME" ]] && ME="claude-$$"
# AMQ requires lowercase agent handles. Managed handles are immutable and
# therefore validated verbatim; only standalone identities are normalized.
if (( MANAGED_IDENTITY == 0 )); then
  ME=$(printf '%s' "$ME" | tr '[:upper:]' '[:lower:]' | sed 's|[^a-z0-9_-]|-|g; s|^-\+||; s|-\+$||')
fi
if [[ -z "$ME" || ${#ME} -gt 64 || ! "$ME" =~ ^[a-z0-9_-]+$ ]]; then
  printf 'claude-amq: refusing invalid or overlong AMQ handle\n' >&2
  exit 1
fi

# Export AM_ME so that descendants of `amq wake` (notably the
# `yaran-amq-inject-bridge` spawned per notification) can identify the
# receiver without re-deriving it from CWD. The yaran-side drainer keys
# its inject-queue on this value.
export AM_ME="$ME"

ROOT="${AMQ_GLOBAL_ROOT:-$STATE_ROOT/amq}"
export AM_ROOT="$ROOT"

ME_REGISTRATION="$ROOT/agents/$ME/.dux-amq-source"
FLOCK_BIN="${YARAN_AMQ_FLOCK:-flock}"

claim_and_register_locked() {
  local cfg="$ROOT/meta/config.json" marker="$ME_REGISTRATION"
  local agent_dir="$ROOT/agents/$ME" tmp prev current_real prev_real created created_dir=0
  # The durable core marker keeps its historical name. Also read markers
  # created by rebrand previews, without overwriting or unlinking either.
  if [[ ! -e "$marker" && ! -L "$marker" && ( -e "$agent_dir/.yaran-amq-source" || -L "$agent_dir/.yaran-amq-source" ) ]]; then
    marker="$agent_dir/.yaran-amq-source"
  fi
  if [[ -e "$agent_dir" || -L "$agent_dir" ]]; then
    [[ -d "$agent_dir" && ! -L "$agent_dir" ]] || return 1
  else
    mkdir -m 0700 "$agent_dir" || return 1
    created_dir=1
  fi
  if [[ -n "${YARAN_STORE_ID:-}" ]]; then
    if [[ -e "$marker" || -L "$marker" ]]; then
      if [[ -L "$marker" ]] || ! jq -e --arg store "$YARAN_STORE_ID" --arg session "$YARAN_SESSION_ID" \
        '.store_id == $store and .session_id == $session' "$marker" >/dev/null 2>&1; then
        printf '[yaran-amq] identity collision: %s has a foreign ownership marker\n' "$ME" >&2
        return 1
      fi
    elif (( created_dir == 1 )); then
      tmp=$(mktemp "$agent_dir/.owner.tmp.XXXXXX") || return 1
      if ! jq -cn --arg store "$YARAN_STORE_ID" --arg session "$YARAN_SESSION_ID" \
        '{store_id:$store,session_id:$session}' >"$tmp" || ! mv "$tmp" "$marker"; then
        rm -f "$tmp"
        return 1
      fi
    else
      printf '[yaran-amq] identity collision: %s has an ownerless agent directory\n' "$ME" >&2
      return 1
    fi
  elif [[ -e "$marker" || -L "$marker" ]]; then
    if [[ -L "$marker" ]]; then
      prev=$(readlink "$marker" 2>/dev/null || true)
    else
      prev=$(cat "$marker" 2>/dev/null || true)
    fi
    current_real=$(realpath -- "$PWD" 2>/dev/null || true)
    prev_real=$(realpath -- "$prev" 2>/dev/null || true)
    if [[ "$prev" != "$PWD" && ( -z "$current_real" || -z "$prev_real" || "$prev_real" != "$current_real" ) ]]; then
      printf '\033[1;31m!\033[0m [yaran-amq] identity collision: %s already registered to %s (current: %s).\n' \
        "$ME" "${prev:-<unknown>}" "$PWD" >&2
      return 1
    fi
  elif (( created_dir == 1 )); then
    ln -s "$PWD" "$marker" || return 1
  else
    printf '[yaran-amq] identity collision: %s has an ownerless agent directory\n' "$ME" >&2
    return 1
  fi
  chmod 0700 "$agent_dir" || return 1

  tmp=$(mktemp "$ROOT/meta/config.json.tmp.XXXXXX") || return 1
  created=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if [[ -f "$cfg" ]]; then
    jq --arg me "$ME" '.agents = ((.agents // []) + [$me] | unique)' "$cfg" >"$tmp"
  else
    jq -n --arg me "$ME" --arg created "$created" \
      '{version:1,created_utc:$created,agents:[$me]}' >"$tmp"
  fi
  mv "$tmp" "$cfg"
}

mkdir -p "$ROOT/meta" "$ROOT/agents" || exit 1
command -v "$FLOCK_BIN" >/dev/null 2>&1 || {
  printf 'claude-amq: mandatory flock utility is unavailable\n' >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  printf 'claude-amq: jq is required for atomic AMQ registration\n' >&2
  exit 1
}
export ROOT ME ME_REGISTRATION YARAN_STORE_ID YARAN_SESSION_ID
export -f claim_and_register_locked
"$FLOCK_BIN" -x "$ROOT/meta/config.lock" bash -euo pipefail -c claim_and_register_locked

# YOLO is OPT-IN. Set CLAUDE_AMQ_YOLO=1 (or legacy CLAUDE_YOLO=1) to enable.
# Anthropic CVEs in 2025–26 (CVE-2025-59536 et al) targeted credential
# exfil through this attack class — default-deny is mandatory in prod.
EXTRA=()
if [[ "${CLAUDE_AMQ_YOLO:-${CLAUDE_YOLO:-}}" == "1" ]]; then
  EXTRA+=(--dangerously-skip-permissions)
  printf 'claude-amq: YOLO enabled — tool calls will not prompt\n' >&2
fi

# Claude-targeted Yaran routing is intentionally forced through Claude
# Peers. Claude Code's allowlisted --channels path no longer accepts
# local `server:` channels; Claude Peers' own docs require the dev-channel
# flag for `server:claude-peers`.
# Set CLAUDE_PEERS_DISABLE=1 only for low-level diagnostics.
if [[ "${CLAUDE_PEERS_DISABLE:-}" != "1" ]]; then
  EXTRA+=(--dangerously-load-development-channels server:claude-peers)
  # Claude Code's /restart and its switch onto an updated build re-exec
  # through CLAUDE_CODE_PROCESS_WRAPPER with an argv that drops the flag
  # above; claude-peers-launcher puts it back for this pane's terminal.
  PEERS_LAUNCHER="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/claude-peers-launcher"
  if [[ -n "${CLAUDE_CODE_PROCESS_WRAPPER:-}" ]]; then
    printf 'claude-amq: CLAUDE_CODE_PROCESS_WRAPPER is already set, so a Claude Code /restart will turn claude-peers off for this pane\n' >&2
  elif [[ -x "$PEERS_LAUNCHER" ]] && PANE_TTY=$(tty 2>/dev/null); then
    export CLAUDE_CODE_PROCESS_WRAPPER="$PEERS_LAUNCHER" YARAN_CLAUDE_PEERS_TTY="$PANE_TTY"
  fi
fi

# audit03 Phase 01 §15: per-session system-prompt override.
#
# yaran exports YARAN_SYSTEM_PROMPT in the per-PTY child env when the
# operator sets a non-empty per-session system prompt in the session
# settings modal. Claude supports this directly via the
# `--append-system-prompt <text>` flag, which appends the text to the
# default system prompt for the session (verified against
# `claude --help`).
#
# The flag accepts an arbitrary string (including embedded newlines).
# We pass the env var verbatim — quoting via `"$YARAN_SYSTEM_PROMPT"`
# keeps shell metacharacters and newlines intact across the exec
# boundary.
if [[ -n "${YARAN_SYSTEM_PROMPT:-}" ]]; then
  EXTRA+=(--append-system-prompt "$YARAN_SYSTEM_PROMPT")
fi

# Transitional warning for users who set the legacy opt-out variable.
# CLAUDE_AMQ_SAFE used to disable YOLO; since YOLO is now opt-in, the
# variable is meaningless and silently keeping it set hides intent.
if [[ -n "${CLAUDE_AMQ_SAFE:-}" ]]; then
  printf 'claude-amq: CLAUDE_AMQ_SAFE is deprecated; YOLO is now opt-in via CLAUDE_AMQ_YOLO\n' >&2
fi

# Route incoming messages through AMQ's owner-bound co-op wake. Two
# transports are wired:
#
#   raw  → `amq wake --inject-mode raw` — uses `ioctl(TIOCSTI)` to push
#          characters into the controlling TTY. Fast, in-process, but
#          REQUIRES `dev.tty.legacy_tiocsti=1` on Linux. Kernels built
#          with `CONFIG_LEGACY_TIOCSTI=n` (Linux 6.2+, Ubuntu 24.04,
#          Debian 12+) silently drop every notification.
#   via  → `amq wake --inject-via yaran-amq-inject-bridge` — AMQ spawns
#          the bridge per notification with the envelope as argv. The
#          bridge calls amq-receive-verify (HMAC + freshness + replay)
#          and, on success, uses tmux send-keys / a file queue to
#          deliver the body. Works on any kernel.
#
# Selection priority:
#   1. YARAN_AMQ_INJECT_MODE env var (escape hatch / test override).
#   2. Presence of $STATE_ROOT/yaran/.tiocsti-state (written by install.sh
#      when it detects a TIOCSTI-disabled kernel) → via.
#   3. Default → raw (preserves the legacy fast path on TIOCSTI-OK hosts).
#
LOCAL_BIN="${LOCAL_BIN:-$HOME/.local/bin}"
BRIDGE="$LOCAL_BIN/yaran-amq-inject-bridge"
if [[ ! -x "$BRIDGE" ]]; then
  BRIDGE=$(command -v yaran-amq-inject-bridge 2>/dev/null || true)
fi

INJECT_MODE="${YARAN_AMQ_INJECT_MODE:-}"
if [[ -z "$INJECT_MODE" ]]; then
  if [[ -f "$STATE_ROOT/yaran/.tiocsti-state" || -f "$STATE_ROOT/dux/.tiocsti-state" ]]; then
    INJECT_MODE="via"
  else
    INJECT_MODE="raw"
  fi
fi

WAKE_ARGS=(--require-wake -y)
case "$INJECT_MODE" in
  raw)
    WAKE_ARGS+=(--wake-inject-mode raw)
    ;;
  via)
    # The bridge MUST be a single executable — AMQ doesn't support
    # shell-pipeline strings as `--inject-via`. The bridge wraps verify
    # and the inject strategy; see yaran-amq/scripts/yaran-amq-inject-bridge.
    if [[ -z "$BRIDGE" || ! -x "$BRIDGE" ]]; then
      printf 'claude-amq: yaran-amq-inject-bridge not found; refusing to start without wake\n' >&2
      exit 1
    fi
    WAKE_ARGS+=(--wake-inject-via "$BRIDGE")
    ;;
  *)
    printf 'claude-amq: YARAN_AMQ_INJECT_MODE=%q not understood; using raw\n' "$INJECT_MODE" >&2
    WAKE_ARGS+=(--wake-inject-mode raw)
    ;;
esac

# AMQ leaves exact owner claims after an unclean exit. Recover only that
# format; ownerless legacy locks are retired by coop's `-y` migration path.
if jq -e '.owner.pid | numbers' "$ROOT/agents/$ME/.wake.lock" >/dev/null 2>&1; then
  amq wake recover-owner --root "$ROOT" --me "$ME" --strict >/dev/null
fi

if [[ -n "${YARAN_PANE:-}" && "${YARAN_AMQ_VERIFY:-0}" != "1" ]]; then
  if [[ -z "$BRIDGE" || ! -x "$BRIDGE" ]]; then
    printf 'claude-amq: yaran-amq-inject-bridge not found; refusing to start without backlog recovery\n' >&2
    exit 1
  fi
  YARAN_AMQ_STARTUP_OWNER_PID="$$" "$BRIDGE" &
fi

exec amq coop exec --no-init --root "$ROOT" --me "$ME" "${WAKE_ARGS[@]}" claude -- ${EXTRA[@]+"${EXTRA[@]}"} "$@"
